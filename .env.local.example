# When enabled, users must sign in with Google (allowlisted emails only). See docs/AUTH-SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ENABLED=true
# Optional GitHub Pages base path, e.g. /2026_Tokyo (affects OAuth redirect URL)
# NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SUPABASE_TABLE=trip_state
NEXT_PUBLIC_SUPABASE_ROW_ID=family-trip

# Supabase Storage (trip photos). Bucket name must match Dashboard → Storage.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=trip-photos
NEXT_PUBLIC_SUPABASE_STORAGE_ENABLED=true
# S3 access keys are for CLI/tools only — never commit them or expose in the browser.

NEXT_PUBLIC_MAP_QUERY=Tokyo, Japan
NEXT_PUBLIC_MAP_ZOOM=12
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=